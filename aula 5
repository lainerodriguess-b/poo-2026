import java.util.ArrayList;
import java.util.List;

public class Main {
    public static void main(String[] args) {

        Item espada = new Item("Espada de Aço", 3);

        Mago laine = new Mago("Laine", 80, 5);
        Guerreiro mari = new Guerreiro("Mari", 100, 5);

        laine.pegar(espada);

        Chefe chefe = new Chefe("Ana Julia");

        List<Personagem> personagens = new ArrayList<>();

        personagens.add(laine);
        personagens.add(mari);

        for (Personagem personagem : personagens) {

            System.out.println(personagem.ficha());

            System.out.println(
                personagem.getNome() + " usa " + personagem.habilidade()
            );

            personagem.atacar(chefe);

            System.out.println();
        }

        System.out.println("Chefe:");
        System.out.println(chefe.ficha());
    }
}

abstract class Personagem {

    private String nome;
    private int vida;
    private int nivel;

    private List<Item> inventario = new ArrayList<>();

    public Personagem(String nome, int vida, int nivel) {
        setNome(nome);
        setVida(vida);
        setNivel(nivel);
    }

    public String getNome() {
        return nome;
    }

    public int getVida() {
        return vida;
    }

    public int getNivel() {
        return nivel;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public void setVida(int vida) {
        if (vida >= 0 && vida <= 200) {
            this.vida = vida;
        } else {
            System.out.println("Vida invalida!");
        }
    }

    public void setNivel(int nivel) {
        if (nivel >= 1) {
            this.nivel = nivel;
        } else {
            System.out.println("Nivel invalido!");
        }
    }

    public void pegar(Item item) {
        inventario.add(item);
    }

    public List<Item> getInventario() {
        return inventario;
    }

    public void receberDano(int dano) {
        vida -= dano;

        if (vida < 0) {
            vida = 0;
        }
    }

    public void atacar(Personagem alvo) {
        alvo.receberDano(10);
    }

    public abstract String habilidade();

    public String ficha() {
        String resultado = "Nome: " + nome + "\n";
        resultado += "Vida: " + vida + "\n";
        resultado += "Nivel: " + nivel + "\n";
        resultado += "Habilidade: " + habilidade() + "\n";
        resultado += "Inventario:\n";

        if (inventario.isEmpty()) {
            resultado += "Nenhum item\n";
        } else {
            for (Item item : inventario) {
                resultado += "- " + item.descricao() + "\n";
            }
        }

        return resultado;
    }
}

class Item {

    private String nome;
    private int bonus;

    public Item(String nome, int bonus) {
        this.nome = nome;

        if (bonus >= 0) {
            this.bonus = bonus;
        } else {
            throw new IllegalArgumentException(
                "Bonus nao pode ser negativo"
            );
        }
    }

    public String getNome() {
        return nome;
    }

    public int getBonus() {
        return bonus;
    }

    public String descricao() {
        return nome + " (+" + bonus + ")";
    }
}

class Mago extends Personagem {

    private int mana;

    public Mago(String nome, int vida, int nivel) {
        super(nome, vida, nivel);
        mana = 50;
    }

    public int getMana() {
        return mana;
    }

    public void setMana(int mana) {
        if (mana >= 0) {
            this.mana = mana;
        } else {
            System.out.println("Mana invalida!");
        }
    }

    @Override
    public String habilidade() {
        return "rajada arcana";
    }

    @Override
    public String ficha() {
        return super.ficha() + "Mana: " + mana + "\n";
    }
}

class Guerreiro extends Personagem {

    private int defesa;

    public Guerreiro(String nome, int vida, int nivel) {
        super(nome, vida, nivel);
        defesa = 5;
    }

    public int getDefesa() {
        return defesa;
    }

    public void setDefesa(int defesa) {
        if (defesa >= 0) {
            this.defesa = defesa;
        } else {
            System.out.println("Defesa invalida!");
        }
    }

    @Override
    public String habilidade() {
        return "escudo de aço";
    }

    @Override
    public void receberDano(int dano) {
        int danoEfetivo = Math.max(0, dano - defesa);
        super.receberDano(danoEfetivo);
    }

    @Override
    public String ficha() {
        return super.ficha() + "Defesa: " + defesa + "\n";
    }
}

class Chefe extends Personagem {

    private int forca;

    public Chefe(String nome) {
        super(nome, 200, 1);
        this.forca = 20;
    }

    public int getForca() {
        return forca;
    }

    public void setForca(int forca) {
        if (forca >= 0) {
            this.forca = forca;
        } else {
            System.out.println("Forca invalida!");
        }
    }

    @Override
    public String habilidade() {
        return "ataque devastador";
    }

    @Override
    public String ficha() {
        return "[CHEFE] " + getNome()
            + " (vida: " + getVida()
            + ", forca: " + forca + ")\n";
    }
}
